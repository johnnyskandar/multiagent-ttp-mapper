# Copy this file to .env and fill in real values. Never commit .env.

# Chat provider. Currently supported: groq
LLM_PROVIDER=groq
# Chat model name for the chosen provider (not chosen yet; example: llama-3.3-70b-versatile)
LLM_MODEL=
# API key for Groq (https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key-here

# Local sentence-transformers embedding model, no API key needed
# (not chosen yet; example: sentence-transformers/all-MiniLM-L6-v2)
EMBEDDING_MODEL=

# 1 = cache LLM responses on disk in llm_cache/, 0 = no cache
LLM_CACHE=1

# Reports longer than this are truncated with a warning
MAX_REPORT_CHARS=20000
